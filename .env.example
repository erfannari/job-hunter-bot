# ===================================================================
# Nari Georgia Jobs - Environment Configuration Example
# Copy this file to .env and fill in your real values.
# NEVER commit your real .env file to version control.
# ===================================================================

# Telegram Bot Token from @BotFather (Required)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Your Telegram numeric Chat ID / User ID (Optional for single-user restriction)
TELEGRAM_CHAT_ID=

# Environment mode: development | production | test
NODE_ENV=development

# Job scanning interval in minutes (Default: 15)
JOB_SCAN_INTERVAL_MINUTES=15

# Minimum match score percentage to trigger a notification (Default: 60)
MIN_MATCH_SCORE=60

# AI Deep Analysis Configuration (Google Gemini)
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here

# Future Database (PostgreSQL optional)
# DATABASE_URL=postgresql://user:password@localhost:5432/georgia_jobs
